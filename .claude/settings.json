{
  "permissions": {
    "allow": [
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run build:verify)",
      "Bash(python3 .githooks/check_site.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(rm -rf:*)",
      "Read(./.env*)",
      "Read(./**/.env*)"
    ]
  }
}
